# Copy this file to .env.qa (ignored by Git) for the isolated browser QA environment.
# Replace the key with a newly generated QA-only key before starting the app.
APP_NAME=CRYMA-QA
APP_ENV=qa
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

# These resolve under the current Windows user's LocalAppData directory.
# The guard requires the directory and database path to remain under CRYMA-QA.
DB_CONNECTION=sqlite
DB_DATABASE="${LOCALAPPDATA}/CRYMA-QA/database.sqlite"
DB_URL=
DB_FOREIGN_KEYS=true

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=local

# Laravel's storage_path() honors LARAVEL_STORAGE_PATH. This isolates local
# uploads, framework cache/session files, and file-based logs from the project.
LARAVEL_STORAGE_PATH="${LOCALAPPDATA}/CRYMA-QA/storage"
LOG_CHANNEL=single
LOG_LEVEL=debug

